# NeuroAPI — copy to .env at the repo root (the server reads it; the client needs nothing).
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated allowlist for CORS. Same-origin in production needs none of this.
CORS_ORIGIN=http://localhost:5173

# Demo API keys. Shown in the Playground and README by design.
# In development they fall back to the values below; in production they are REQUIRED.
DEMO_WRITE_KEY=neuro_write_demo_9f2k7q
DEMO_READ_KEY=neuro_read_demo_3m8x1z
